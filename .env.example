# Copy this file to ".env" and fill in your own keys. run.bat loads it automatically.
# Both keys are free.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-yours-here

# https://huggingface.co/settings/tokens (Read token is enough)
HF_TOKEN=hf_paste-yours-here

# HeyGen (paid, optional): https://app.heygen.com/settings/api
# Pay-as-you-go, min $5 top-up. ~$1/min of video (720p standard), so ~$0.50
# per short video here. Leave unset to let each user paste their own key.
# HEYGEN_API_KEY=

# WaveSpeed (paid, the default paid renderer): https://wavespeed.ai/accesskey
# Model-hosting marketplace. Audio-driven talking heads, billed on audio length:
#   infinitetalk-fast  $0.015/s ($0.90/min), 5s billing floor, up to 10 min
#   ltx-2.3/lipsync    $0.030/s at 720p ($1.80/min), audio must be 5-20s
# Leave unset to let each user paste their own key.
# WAVESPEED_API_KEY=

# Optional (WaveSpeed):
# WAVESPEED_PROMPT=       (steer expression/pose, e.g. "warm, engaged presenter")
# WAVESPEED_UPLOAD_CACHE=0  (do NOT reuse uploaded photo URLs. Reuse saves an
#                          upload per render but keeps the face live on their
#                          CDN longer; uploads expire after 7 days either way.)

# NOTE: renderers never substitute for one another. If the engine you picked
# fails you get the reason, not a quieter video you did not ask for. RENDERER
# below sets the default choice; "motion" is a deliberate option (no GPU, no
# network, no key) rather than something that happens to you.

# Optional:
# HEYGEN_VOICE_ID=        (pin a voice; default: first English voice found)
# HEYGEN_AVATAR_IV=1      (Avatar IV engine: gestures + expressions, $4/min.
#                          Restart the app after changing this.)
# HEYGEN_MOTION_PROMPT=   (Avatar IV only: describe wanted gestures/movement)
# VOICE=en-US-ChristopherNeural
# RENDERER=motion        (default engine when the form does not name one;
#                         "motion" skips the GPU entirely)
# HF_SPACE=owner/space   (use a different HF Space)

# ---- Publish hub (PRD v0.2): connect-once social accounts ----
# LinkedIn developer app (free, self-serve): https://developer.linkedin.com/
# Create an app, add the "Share on LinkedIn" product, set redirect URL to
# http://localhost:5000/hub/callback/linkedin
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Where OAuth callbacks return to. Local dev default shown; a hosted
# deploy needs its public HTTPS base URL here.
# HUB_REDIRECT_BASE=http://localhost:5000

# Token vault encryption key. If unset, one is generated into
# .secrets/vault.key on first run (fine for dev). To set explicitly:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HUB_VAULT_KEY=
